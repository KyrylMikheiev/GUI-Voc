<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<!--
  Account verification. A centred VBox with even spacing keeps the field and the
  button together at any window size.
-->
<VBox alignment="CENTER" spacing="20" styleClass="body-primary"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40" />
    </padding>

    <Label text="Account-Verifizierung" styleClass="screen-title" />

    <VBox spacing="20" alignment="CENTER" maxWidth="560">
        <TextField fx:id="codeField" promptText="Verifizierungs-Code"
                   styleClass="app-field" />

        <Label fx:id="errorLabel" text="Falscher Verifizierungs-Code!"
               styleClass="error-label" visible="false" managed="false" />

        <Button text="Verifizieren" styleClass="app-button" maxWidth="Infinity"
                onAction="#onVerify" />

        <HBox spacing="30" alignment="CENTER">
            <Button text="Zurück zum Login" styleClass="app-button"
                    maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#onToLogin" />
            <Button text="Ich habe keinen Account" styleClass="app-button"
                    maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#onToSignUp" />
        </HBox>
    </VBox>

</VBox>
