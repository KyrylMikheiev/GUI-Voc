<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<!--
  Memory game. The four states (menu, instructions, board, win) are declared
  here and the controller shows one at a time.
-->
<StackPane styleClass="body-primary" xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml">

    <!-- state 0: menu -->
    <VBox fx:id="menuPane" spacing="20" alignment="CENTER">
        <padding>
            <Insets top="40" right="40" bottom="40" left="40" />
        </padding>

        <HBox spacing="10" alignment="CENTER">
            <Label text="Geben Sie eine Anzahl an Pärchen ein:" styleClass="text-label" />
            <TextField fx:id="amountField" prefColumnCount="10" styleClass="app-field" />
        </HBox>

        <Button text="Instructions" styleClass="app-button" minWidth="200"
                onAction="#onInstructions" />

        <HBox spacing="20" alignment="CENTER">
            <Button text="Start" styleClass="app-button" minWidth="140"
                    onAction="#onStart" />
            <Button text="Exit" styleClass="app-button" minWidth="140"
                    onAction="#onExit" />
        </HBox>
    </VBox>

    <!-- state 1: instructions -->
    <VBox fx:id="instructionsPane" spacing="20" alignment="CENTER"
          visible="false" managed="false">
        <padding>
            <Insets top="40" right="40" bottom="40" left="40" />
        </padding>

        <Label styleClass="text-label" wrapText="true" textAlignment="CENTER">
            <text>
Wenn das Spiel beginnt, ist der Bildschirm voller Tastenpaare.
Merken Sie sich deren Anordnung.
Sobald Sie eine Taste drücken, verschwinden sie alle.
Ihr Ziel ist es, die übereinstimmenden Tasten in einer Reihe anzuklicken.
Wenn Sie das geschafft haben, haben Sie gewonnen.
Für jeden falschen Klick bekommen Sie einen Punkt (die sind schlecht).
Viel Glück!
für ein einzelnes Level: Geben Sie ein Level zwischen 1 und 10 ein,
wählen Sie leicht oder schwer, und drücken Sie dann Start.
            </text>
        </Label>

        <Button text="Main Menu" styleClass="app-button" minWidth="200"
                onAction="#onBackToMenu" />
    </VBox>

    <!-- state 2: board -->
    <GridPane fx:id="boardPane" hgap="2" vgap="2" visible="false" managed="false">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10" />
        </padding>
    </GridPane>

    <!-- state 3: win -->
    <VBox fx:id="winPane" spacing="20" alignment="CENTER"
          visible="false" managed="false">
        <padding>
            <Insets top="40" right="40" bottom="40" left="40" />
        </padding>

        <Label text="You Win" styleClass="screen-title" />
        <Label fx:id="failsLabel" styleClass="result-label" />
        <Button text="Main Menu" styleClass="app-button" minWidth="200"
                onAction="#onExit" />
    </VBox>

</StackPane>
