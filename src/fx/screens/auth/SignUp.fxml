<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<!--
  Registration, in two stages.

  The Swing version held a signupStage field and rebuilt the whole screen on
  each step, which is why it had to copy the entered values back into the new
  fields. Both stages are declared here instead and the controller toggles
  which one is visible, so the fields keep their own state.
-->
<VBox alignment="CENTER" spacing="20" styleClass="body-primary"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40" />
    </padding>

    <Label text="Registration" styleClass="screen-title" />

    <StackPane>
        <!-- Stage 1: name + class -->
        <VBox fx:id="stageOne" spacing="20" alignment="CENTER" maxWidth="560">
            <TextField fx:id="firstNameField" promptText="Vorname" styleClass="app-field" />
            <TextField fx:id="lastNameField" promptText="Nachname" styleClass="app-field" />
            <ComboBox fx:id="gradeLevelBox" maxWidth="Infinity" styleClass="app-combo" />

            <Label fx:id="stageOneError" text="Vor- oder Nachname fehlen!"
                   styleClass="error-label" visible="false" managed="false" />

            <Button text="Next" styleClass="app-button" maxWidth="Infinity"
                    onAction="#onNext" />
            <Button text="To Login" styleClass="app-button" maxWidth="Infinity"
                    onAction="#onToLogin" />
        </VBox>

        <!-- Stage 2: credentials -->
        <VBox fx:id="stageTwo" spacing="20" alignment="CENTER" maxWidth="560"
              visible="false" managed="false">
            <TextField fx:id="emailField" promptText="E-Mail" styleClass="app-field" />
            <PasswordField fx:id="passwordField" promptText="Passwort" styleClass="app-field" />
            <PasswordField fx:id="repeatPasswordField" promptText="Passwort wiederholen"
                           styleClass="app-field" />

            <Label fx:id="stageTwoError" styleClass="error-label" visible="false" managed="false" />

            <HBox spacing="30" alignment="CENTER">
                <Button text="Zurück" styleClass="app-button" maxWidth="Infinity"
                        HBox.hgrow="ALWAYS" onAction="#onBack" />
                <Button text="Registrieren" styleClass="app-button" maxWidth="Infinity"
                        HBox.hgrow="ALWAYS" onAction="#onRegister" />
            </HBox>
        </VBox>
    </StackPane>

</VBox>
