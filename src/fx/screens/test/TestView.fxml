<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<!--
  Vocabulary test. Same shape as the Swing screen: the word on top, the
  translation fields on the left, the noun-form fields on the right, and a
  "next" button underneath that cycles through the drawn words.

  The Swing version built its translation panel twice and added both to
  BorderLayout.WEST, so the first was silently discarded; the rows are built
  once here, by the controller, since their number depends on the word.
-->
<VBox spacing="20" styleClass="body-primary" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <Label fx:id="wordLabel" styleClass="test-word" maxWidth="Infinity"
           alignment="CENTER" wrapText="true" />

    <HBox spacing="40" VBox.vgrow="ALWAYS">
        <!-- Übersetzung 1..n; rows added by the controller -->
        <VBox fx:id="translationBox" spacing="10" HBox.hgrow="ALWAYS" />

        <!-- The Swing screen's fixed Nominativ/Dativ fields -->
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10" />
            </padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Nominativ Plural auf Latein:" styleClass="text-label" />
                <TextField fx:id="nominativeField" styleClass="test-field"
                           prefWidth="200" />
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Dativ Singular auf Latein:" styleClass="text-label" />
                <TextField fx:id="dativeField" styleClass="test-field"
                           prefWidth="200" />
            </HBox>
        </VBox>
    </HBox>

    <HBox alignment="CENTER">
        <Button text="Nächste Vokabel" styleClass="app-button" minWidth="200"
                onAction="#onNext" />
    </HBox>

</VBox>
