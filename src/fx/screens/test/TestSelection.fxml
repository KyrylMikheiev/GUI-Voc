<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<!--
  Test setup: choose lessons on the left, options below, start on the right.

  The Swing version declared five separate isCrossVisibleN booleans and five
  near-identical JCheckBox blocks with copied listeners; the checkboxes are
  declared here and read directly. The available/selected lesson pair came from
  LessonRoster, whose GridBagLayout used negative insets (-45) to pull the
  labels into place.
-->
<VBox spacing="15" styleClass="body-primary" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml">
    <padding>
        <Insets top="20" right="30" bottom="20" left="30" />
    </padding>

    <!-- Lesson roster -->
    <GridPane hgap="20" vgap="8" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints percentWidth="42" />
            <ColumnConstraints percentWidth="16" />
            <ColumnConstraints percentWidth="42" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints vgrow="NEVER" />
            <RowConstraints vgrow="ALWAYS" />
        </rowConstraints>

        <Label text="Verfügbare Lektionen" styleClass="title-label"
               GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <Label text="Ausgewählte Lektionen" styleClass="title-label"
               GridPane.columnIndex="2" GridPane.rowIndex="0" />

        <ListView fx:id="availableList" styleClass="app-list"
                  GridPane.columnIndex="0" GridPane.rowIndex="1" />

        <VBox spacing="20" alignment="CENTER" GridPane.columnIndex="1"
              GridPane.rowIndex="1">
            <Button text="Add →" styleClass="app-button" maxWidth="Infinity"
                    onAction="#onAdd" />
            <Button text="← Remove" styleClass="app-button" maxWidth="Infinity"
                    onAction="#onRemove" />
        </VBox>

        <ListView fx:id="selectedList" styleClass="app-list"
                  GridPane.columnIndex="2" GridPane.rowIndex="1" />
    </GridPane>

    <!-- Test options -->
    <VBox spacing="10">
        <CheckBox fx:id="allTranslations" text="Alle Übersetzungen abfragen"
                  styleClass="app-check" />
        <CheckBox fx:id="ignoreOrder" text="Reihenfolge der eingegebenen Übersetzungen ignorieren"
                  styleClass="app-check" />
        <CheckBox fx:id="verbStems" text="Stammformen von Verben abfragen"
                  styleClass="app-check" />
        <CheckBox fx:id="randomDeclension" text="Zufällige Deklination abfragen"
                  styleClass="app-check" />
        <CheckBox fx:id="randomConjugation" text="Zufällige Konjugationen abfragen"
                  styleClass="app-check" />
    </VBox>

    <HBox alignment="CENTER_RIGHT">
        <Button fx:id="startButton" text="Start" styleClass="app-button"
                minWidth="140" onAction="#onStart" />
    </HBox>

</VBox>
