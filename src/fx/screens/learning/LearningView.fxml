<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<!--
  Flashcard learning screen, with the results view stacked behind it.

  The Swing version built this from twelve nested JPanels with names like
  "contentUp_LessonAndProgressBar", then called removeAll() and rebuilt the
  panel to show the results. Both views are declared here and the controller
  toggles between them.
-->
<StackPane styleClass="body-primary" xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml">

    <!-- Flashcard view -->
    <VBox fx:id="cardView" spacing="10">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20" />
        </padding>

        <Label text="Progress:" styleClass="progress-heading" />

        <GridPane>
            <columnConstraints>
                <ColumnConstraints percentWidth="33.34" />
                <ColumnConstraints percentWidth="33.33" />
                <ColumnConstraints percentWidth="33.33" />
            </columnConstraints>
            <Label fx:id="lessonLabel" styleClass="progress-heading"
                   maxWidth="Infinity" alignment="CENTER" GridPane.columnIndex="0" />
            <StackPane GridPane.columnIndex="1">
                <ProgressBar fx:id="progressBar" progress="0" maxWidth="Infinity" />
                <Label fx:id="progressLabel" styleClass="progress-value" />
            </StackPane>
            <!-- The Swing layout left this third column empty. -->
        </GridPane>

        <!-- "one action back", top-left as in the Swing layout -->
        <HBox spacing="20" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="0" bottom="10" left="30" />
            </padding>
            <Button fx:id="backArrowButton" styleClass="icon-button"
                    onAction="#onPrevious" />
            <Label text="Eine Aktion zurück" styleClass="subtitle-label" />
        </HBox>

        <!-- cross | card | checkmark -->
        <GridPane VBox.vgrow="ALWAYS">
            <columnConstraints>
                <ColumnConstraints percentWidth="33.34" />
                <ColumnConstraints percentWidth="33.33" />
                <ColumnConstraints percentWidth="33.33" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="ALWAYS" />
            </rowConstraints>

            <Button fx:id="crossButton" styleClass="mark-button" maxWidth="Infinity"
                    maxHeight="Infinity" GridPane.columnIndex="0" onAction="#onWrong" />

            <StackPane GridPane.columnIndex="1">
                <padding>
                    <Insets top="10" right="20" bottom="10" left="20" />
                </padding>
                <!-- The whole card flips on click, as in the Swing version. -->
                <Button fx:id="flashcard" styleClass="flashcard" maxWidth="Infinity"
                        maxHeight="Infinity" onAction="#onFlip" wrapText="true" />
            </StackPane>

            <Button fx:id="checkButton" styleClass="mark-button" maxWidth="Infinity"
                    maxHeight="Infinity" GridPane.columnIndex="2" onAction="#onCorrect" />
        </GridPane>
    </VBox>

    <!-- Results view -->
    <VBox fx:id="resultView" spacing="30" alignment="CENTER"
          visible="false" managed="false">
        <padding>
            <Insets top="40" right="60" bottom="40" left="60" />
        </padding>

        <Label fx:id="congratulationsLabel" styleClass="screen-title"
               wrapText="true" textAlignment="CENTER" />

        <VBox spacing="15" alignment="CENTER">
            <Label fx:id="rightLabel" styleClass="result-label" />
            <Label fx:id="wrongLabel" styleClass="result-label" />
            <Label fx:id="perfectLabel" text="Prima!" styleClass="result-label"
                   visible="false" managed="false" />
        </VBox>

        <HBox spacing="50" alignment="CENTER" maxWidth="700">
            <Button fx:id="relearnButton" text="Falsche Vokabeln lernen"
                    styleClass="app-button" maxWidth="Infinity"
                    HBox.hgrow="ALWAYS" onAction="#onRelearn" />
            <Button text="Zurück zum Hauptmenü" styleClass="app-button"
                    maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#onMainMenu" />
        </HBox>
    </VBox>

</StackPane>
