<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<!--
  Navigation bar: three evenly-weighted columns. Icons are injected by the
  controller via Images, so no paths appear in the XML.
-->
<GridPane styleClass="navbar" xmlns="http://javafx.com/javafx"
          xmlns:fx="http://javafx.com/fxml">

    <columnConstraints>
        <ColumnConstraints percentWidth="33.34" />
        <ColumnConstraints percentWidth="33.33" />
        <ColumnConstraints percentWidth="33.33" />
    </columnConstraints>

    <!-- Left: back button + app name -->
    <HBox alignment="CENTER_LEFT" spacing="10" GridPane.columnIndex="0">
        <padding>
            <Insets top="9" right="30" bottom="9" left="15" />
        </padding>
        <Button fx:id="backButton" styleClass="icon-button" onAction="#onBack" />
        <Label fx:id="appName" text="Vokabeltrainer" styleClass="navbar-title"
               onMouseClicked="#onHome" />
    </HBox>

    <!-- Middle: quick search -->
    <HBox alignment="CENTER" GridPane.columnIndex="1">
        <padding>
            <Insets top="10" right="0" bottom="10" left="0" />
        </padding>
        <HBox fx:id="searchBox" styleClass="search-box" alignment="CENTER_LEFT"
              spacing="10" HBox.hgrow="ALWAYS">
            <Label fx:id="searchIcon" />
            <TextField fx:id="searchField" promptText="Schnellsuche..."
                       styleClass="search-field" onAction="#onSearch"
                       HBox.hgrow="ALWAYS" />
        </HBox>
    </HBox>

    <!-- Right: burger menu -->
    <HBox alignment="CENTER_RIGHT" GridPane.columnIndex="2">
        <padding>
            <Insets top="0" right="15" bottom="0" left="0" />
        </padding>
        <MenuButton fx:id="burgerMenu" styleClass="icon-button,burger-menu">
            <items>
                <MenuItem fx:id="menuMain" text="Hauptmenü" onAction="#onHome" />
                <MenuItem fx:id="menuSettings" text="Einstellungen" onAction="#onSettings" />
                <MenuItem fx:id="menuLogout" text="Abmelden" onAction="#onLogout" />
                <MenuItem fx:id="menuExit" text="Beenden" onAction="#onExit" />
            </items>
        </MenuButton>
    </HBox>

</GridPane>
